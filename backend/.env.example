APP_NAME="FUTSAL PARK"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# 画面・メッセージは日本語。日本語の翻訳が無い文言だけ英語（フォールバック）で出る。
# テストのダミーデータ（fake()->name() など）も日本語にする。
APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL（docker-compose.yml の postgres サービス）。
# DB_HOST はコンテナ同士の通信なのでサービス名の postgres。
# ユーザー名・パスワードは docker-compose.yml の POSTGRES_USER / POSTGRES_PASSWORD と合わせる。
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=futsal_db
DB_USERNAME=futsal
DB_PASSWORD=futsal

# セッションは PostgreSQL の sessions テーブル（docs/04 の「Redis の用途」）
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# キューは PostgreSQL の jobs テーブル（docs/04 の「Redis の用途」）
QUEUE_CONNECTION=database

# キャッシュ（カレンダーの日ごとの事実）とレート制限は Redis（docs/04 の「キャッシュ方針」）
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis（docker-compose.yml の redis サービス）。phpredis は backend/Dockerfile で入れている
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# メールは Mailpit（docker-compose.yml の mailpit サービス）に送る。
# 送ったメールは http://localhost:8025 で見られる。本番は Resend。
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
